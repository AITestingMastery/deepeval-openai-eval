# Copy this file to .env and fill in your keys

# Your OpenAI key (used to answer questions AND by DeepEval to score them)
OPENAI_API_KEY=sk-...

# Your Confident AI key (the DeepEval dashboard) - get it at https://app.confident-ai.com
CONFIDENT_API_KEY=

# Optional settings
OPENAI_MODEL=gpt-4o-mini
DEEPEVAL_JUDGE_MODEL=gpt-4o-mini
PASS_THRESHOLD=0.7
SYSTEM_PROMPT=You are a helpful assistant. Answer clearly and concisely.
